PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
SENDGRID_API_KEY=
DIALOG360_API_KEY=
WOVEN_API_KEY=
# Paystack (#109). Test key on staging, live key on production only. Never commit a real key.
PAYSTACK_SECRET_KEY=
# Public URL of the web app for this environment, used for the Paystack return link.
WEB_APP_URL=
# Express late refund (Terms section 7). "on" refunds the Express fee automatically when an
# Express order misses its deadline. Leave off until tested on staging.
EXPRESS_AUTO_REFUND=off
# Express fee refunded when we are late, in naira (Express price minus Standard price).
EXPRESS_FEE_NAIRA=1000
# Extra public holidays, comma-separated YYYY-MM-DD (for dates declared at short notice).
PUBLIC_HOLIDAYS=
